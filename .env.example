# Copy to .env and adjust before running `docker compose up`.
# Every value here has a safe default baked into docker-compose.yml, so .env is optional
# for a first run — only needed if you want non-default credentials.

MSSQL_SA_PASSWORD=YourStrong!Passw0rd

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexaflow_analytics

MYSQL_ROOT_PASSWORD=mysql_root_password
MYSQL_DATABASE=nexaflow_notifications

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Must be at least 32 characters for HMAC-SHA256 signing.
JWT_SIGNING_KEY=docker-dev-signing-key-change-me-please-32chars
