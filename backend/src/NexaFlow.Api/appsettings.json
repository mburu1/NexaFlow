{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "_comment_ConnectionStrings": "SQL Server is the only store NexaFlowDbContext actually talks to in Phase 1 (see docs/adr/001-database-strategy.md). Postgres/MySQL/Mongo are provisioned for future phases (analytics, notifications-service DB, audit-log store) and are unused by application code today.",
  "ConnectionStrings": {
    "MsSql": "Server=YOUR_SQL_SERVER;Database=NexaFlow;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True",
    "Postgres": "Host=YOUR_POSTGRES_HOST;Port=5432;Username=postgres;Password=YOUR_PASSWORD;Database=nexaflow_analytics",
    "MySql": "Server=YOUR_MYSQL_HOST;Port=3306;Database=nexaflow_notifications;User=root;Password=YOUR_PASSWORD",
    "Mongo": "mongodb://YOUR_MONGO_HOST:27017",
    "Redis": "YOUR_REDIS_HOST:6379"
  },

  "Jwt": {
    "Issuer": "NexaFlow",
    "Audience": "NexaFlow.Client",
    "SigningKey": "REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "RabbitMq": {
    "HostName": "YOUR_RABBITMQ_HOST",
    "Port": 5672,
    "UserName": "guest",
    "Password": "YOUR_PASSWORD"
  },
  "Kafka": {
    "BootstrapServers": "YOUR_KAFKA_HOST:9092"
  },
  "Smtp": {
    "Host": "YOUR_SMTP_HOST",
    "Port": 587,
    "FromAddress": "noreply@nexaflow.io",
    "FromName": "NexaFlow",
    "UseSsl": true,
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD"
  },

  "Cors": {
    "AllowedOrigins": [ "https://YOUR_FRONTEND_DOMAIN" ]
  }
}
