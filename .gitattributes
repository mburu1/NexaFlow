# Auto detect text files and perform LF normalization
* text=auto eol=lf

*.cs text diff=csharp
*.csproj text
*.sln text
*.slnx text
*.json text
*.md text
*.yml text
*.yaml text

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.dll binary
*.exe binary
